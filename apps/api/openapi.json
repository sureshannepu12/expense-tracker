  "info": {
    "title": "Expense Tracker API",
    "description": "REST API for the expense tracker. All amounts are integers in cents/paise.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jane@example.com",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "createdAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "nullable": true
          },
          "expenseCount": {
            "type": "number",
            "description": "How many expenses use this category."
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "icon",
          "expenseCount",
          "id",
          "name",
          "color"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "nullable": true,
            "description": "A short emoji shown next to the name. Send null to remove it.",
            "maxLength": 8,
            "example": "🛒"
          },
          "name": {
            "type": "string",
            "example": "Groceries",
            "minLength": 1,
            "maxLength": 30
          },
          "color": {
            "type": "string",
            "description": "Hex color used in charts and badges, always \"#rrggbb\".",
            "example": "#22c55e",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "nullable": true,
            "description": "A short emoji shown next to the name. Send null to remove it.",
            "maxLength": 8,
            "example": "🛒"
          },
          "name": {
            "type": "string",
            "example": "Groceries",
            "minLength": 1,
            "maxLength": 30
          },
          "color": {
            "type": "string",
            "description": "Hex color used in charts and badges, always \"#rrggbb\".",
            "example": "#22c55e",
            "pattern": "^#[0-9a-f]{6}$"
          }
        }
      },
      "ExpenseSortField": {
        "type": "string",
        "enum": [
          "date",
          "amount",
          "createdAt"
        ]
      },
      "SortOrder": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ]
      },
      "CategorySummaryDto": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "icon",
          "id",
          "name",
          "color"
        ]
      },
      "ExpenseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "Amount in cents/paise."
          },
          "description": {
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/CategorySummaryDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "amount",
          "description",
          "date",
          "categoryId",
          "category",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "PaginatedExpensesDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CreateExpenseDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount in cents/paise (e.g. 1250 = 12.50).",
            "example": 1250,
            "minimum": 1,
            "maximum": 1000000000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "description": "Date the money was spent (YYYY-MM-DD).",
            "example": "2026-09-30"
          },
          "categoryId": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "description",
          "date",
          "categoryId"
        ]
      },
      "UpdateExpenseDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount in cents/paise (e.g. 1250 = 12.50).",
            "example": 1250,
            "minimum": 1,
            "maximum": 1000000000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "description": "Date the money was spent (YYYY-MM-DD).",
            "example": "2026-09-30"
          },
          "categoryId": {
            "type": "string"
          }
        }
      },
      "BudgetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "month": {
            "type": "string",
            "description": "YYYY-MM"
          },
          "amount": {
            "type": "number",
            "description": "Budget limit in cents/paise."
          },
          "categoryId": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/CategorySummaryDto"
          },
          "spent": {
            "type": "number",
            "description": "Total spent in this category during the month (cents/paise)."
          },
          "remaining": {
            "type": "number",
            "description": "amount - spent. Negative when over budget."
          }
        },
        "required": [
          "id",
          "month",
          "amount",
          "categoryId",
          "category",
          "spent",
          "remaining"
        ]
      },
      "UpsertBudgetDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "month": {
            "type": "string",
            "example": "2026-09"
          },
          "amount": {
